  <diagram name="Self-Mounting Embeds" id="embed-overview">
    <mxGraphModel dx="1992" dy="1062" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
