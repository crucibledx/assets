        <mxCell id="punch" parent="1" style="text;html=1;fontSize=13;fontStyle=3;align=center;fontColor=#333;whiteSpace=wrap;" value="&amp;ldquo;One &amp;lt;script&amp;gt; tag, one custom element. That&amp;rsquo;s all it takes to embed a full React/Vue/Svelte app into any page.&amp;rdquo;" vertex="1">
