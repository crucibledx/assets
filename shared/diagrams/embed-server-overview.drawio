        <mxCell id="title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333;" value="Self-Mounting Micro-Frontends (Article 0)" vertex="1">
          <mxGeometry height="35" width="550" x="245" y="8" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#666666;whiteSpace=wrap;" value="Autonomous UI modules that bundle, mount, and run independently inside any host page" vertex="1">
          <mxGeometry height="22" width="530" x="255" y="43" as="geometry" />
        </mxCell>
        <mxCell id="problem-label" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#b85450;align=center;" value="The Problem" vertex="1">
          <mxGeometry height="18" width="100" x="55" y="70" as="geometry" />
        </mxCell>
        <mxCell id="problem-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;strokeWidth=1;align=left;spacingLeft=8;verticalAlign=middle;" value="&amp;#10007; Legacy UIs (JSP/servlets) can&amp;rsquo;t adopt modern frameworks&lt;br&gt;&amp;#10007; Monolithic frontend coupled to backend&lt;br&gt;&amp;#10007; Teams blocked: one repo, one deploy, one framework&lt;br&gt;&amp;#10007; Full rewrite is too expensive" vertex="1">
          <mxGeometry height="70" width="310" x="55" y="90" as="geometry" />
        </mxCell>
        <mxCell id="solution-label" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2D7600;align=center;" value="The Pattern" vertex="1">
          <mxGeometry height="18" width="100" x="395" y="70" as="geometry" />
        </mxCell>
        <mxCell id="solution-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;strokeWidth=1;align=left;spacingLeft=8;verticalAlign=middle;" value="&amp;#10003; Each feature = one JS bundle that self-mounts via custom HTML tag&lt;br&gt;&amp;#10003; Different frameworks per embed (React, Vue, Svelte, Angular)&lt;br&gt;&amp;#10003; Independent build, deploy, and test per team&lt;br&gt;&amp;#10003; Drop into ANY HTML page, even legacy JSP" vertex="1">
          <mxGeometry height="70" width="340" x="395" y="90" as="geometry" />
        </mxCell>
        <mxCell id="e-problem-solution" edge="1" parent="1" source="problem-box" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#82b366;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="solution-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="versus-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=8;strokeWidth=1;align=left;spacingLeft=5;verticalAlign=top;spacingTop=4;fontStyle=1;fontColor=#666;" value="vs. Alternatives&lt;div style=&quot;font-weight: normal;&quot;&gt;Module Federation: high build complexity&lt;br&gt;Single-SPA: medium runtime overhead&lt;br&gt;iFrames: heavy, no shared layout&lt;br&gt;&lt;b style=&quot;color: #2D7600&quot;&gt;Embeds: minimal overhead, low learning curve&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="765" y="90" as="geometry" />
        </mxCell>
