        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;" value="Session 5&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Chaos Engineering&lt;/span&gt;" vertex="1">
