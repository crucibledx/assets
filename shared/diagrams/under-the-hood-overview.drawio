        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;" value="Session 1&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The IoC Flip&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="210" x="30" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s1-desc" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#333;whiteSpace=wrap;spacingLeft=5;" value="Library vs Framework.&lt;br&gt;Hollywood Principle: &amp;ldquo;Don&amp;rsquo;t call us, we&amp;rsquo;ll call you.&amp;rdquo;&lt;br&gt;&lt;br&gt;&lt;b&gt;Key insight:&lt;/b&gt; Control is the only difference." vertex="1">
          <mxGeometry height="60" width="210" x="30" y="205" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;" value="Session 2&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Dependency Injection&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="210" x="300" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s2-desc" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#333;whiteSpace=wrap;spacingLeft=5;" value="IoC applied to wiring.&lt;br&gt;Constructor vs field injection.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hands-on:&lt;/b&gt; Build a DI container from scratch." vertex="1">
          <mxGeometry height="60" width="210" x="300" y="205" as="geometry" />
        </mxCell>
        <mxCell id="internals-label" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#82b366;align=center;" value="Framework Internals" vertex="1">
          <mxGeometry height="18" width="140" x="745" y="145" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;" value="Session 3&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Who Owns the Main Loop?&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="210" x="570" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s3-desc" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#333;whiteSpace=wrap;spacingLeft=5;" value="Framework lifecycle and request flow.&lt;br&gt;Servlet containers, ASGI, middleware.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hands-on:&lt;/b&gt; Trace one request end to end." vertex="1">
          <mxGeometry height="60" width="210" x="570" y="205" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;" value="Session 4&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Proxy Pattern &amp;amp; AOP&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="210" x="840" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s4-desc" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#333;whiteSpace=wrap;spacingLeft=5;" value="The magic behind @Transactional, @Cacheable.&lt;br&gt;Proxies, decorators, middleware are one idea.&lt;div&gt;&lt;br&gt;&lt;b&gt;Hands-on:&lt;/b&gt; Add observability, zero code changes.&lt;/div&gt;" vertex="1">
          <mxGeometry height="55" width="210" x="840" y="205" as="geometry" />
