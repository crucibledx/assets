        </mxCell>
        <mxCell id="s5-desc" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#333;whiteSpace=wrap;spacingLeft=5;" value="Breaking things so your users don&amp;rsquo;t have to.&lt;br&gt;DI lets you swap failable deps. Proxies trace failures.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hands-on:&lt;/b&gt; Netflix Chaos Monkey, your scale." vertex="1">
