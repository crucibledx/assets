        <mxCell id="foundations-label" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#9673a6;align=center;" value="Foundations" vertex="1">
          <mxGeometry height="18" width="100" x="220" y="145" as="geometry" />
