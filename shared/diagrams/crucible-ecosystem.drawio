        <mxCell id="forge-desc" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#1A237E;whiteSpace=wrap;spacingLeft=3;" value="&lt;b&gt;AI Resource Lifecycle Platform&lt;/b&gt;&lt;br&gt;Sync shared skills, rules, workflows&lt;br&gt;from central source to every AI tool&lt;br&gt;in the right format.&lt;br&gt;&lt;br&gt;&amp;#10003; 12 commands (init, sync, status, health...)&lt;br&gt;&amp;#10003; 5 AI assistants supported&lt;br&gt;&amp;#10003; Git + Local sources&lt;br&gt;&amp;#10003; Auto layout detection&lt;br&gt;&amp;#10003; Scheduler (auto-sync)&lt;br&gt;&amp;#10003; SHA-256 change detection&lt;br&gt;&amp;#10003; Conflict resolution" vertex="1">
