        </mxCell>
        <mxCell id="tier0-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=12;fontStyle=1;strokeWidth=2;fontColor=#37474F;verticalAlign=top;spacingTop=5;" value="Tier 0 — Operational Events (exists today)" vertex="1">
