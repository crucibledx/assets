        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=13;fontStyle=2;align=center;fontColor=#E65100;whiteSpace=wrap;" value="Each tier adds a new data dimension. Start with manifest analytics, grow into full observability." vertex="1">
