        </mxCell>
        <mxCell id="tier0-desc" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#37474F;whiteSpace=wrap;spacingLeft=5;" value="Forge already emits operational telemetry: sync events, duration, success/failure, file counts. Stored in ~/.crucible/forge/telemetry/ as JSONL.&lt;br&gt;&lt;b&gt;Answers:&lt;/b&gt; &amp;ldquo;Is Forge working? When was last sync? How often does sync fail?&amp;rdquo;" vertex="1">
