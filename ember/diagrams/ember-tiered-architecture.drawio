        <mxCell id="t1-fleet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=9;fontStyle=1;strokeWidth=1;fontColor=#1A237E;" value="v0.2 — Fleet View&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;Multi-project discovery,&lt;br&gt;version drift, adoption&lt;/span&gt;" vertex="1">
