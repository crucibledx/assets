        </mxCell>
        <mxCell id="t1-manifest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=9;fontStyle=1;strokeWidth=1;fontColor=#1A237E;" value="forge.manifest.json&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;skills, versions, hashes,&lt;br&gt;agents, token estimates&lt;/span&gt;" vertex="1">
