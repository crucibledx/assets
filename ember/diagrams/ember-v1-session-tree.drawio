        </mxCell>
        <mxCell id="a5" value="invoke_agent worker&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;subagent · parent = Task tool span&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="240" height="50" as="geometry" />
