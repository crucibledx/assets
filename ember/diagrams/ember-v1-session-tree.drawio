<mxfile host="assetkit">
  <diagram name="Ember v1 session tree" id="ember-v1-session-tree">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1260" height="750" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Ember v1 session tree" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One trace per Droid workstream with deterministic ids; native spans move under Ember's spans; work in other harnesses joins on ember.work.id" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="55" width="1220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="work" value="ember.work.id = ENG-42&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;the Agent tree groups both traces&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fa" value="Droid workstream · one trace (workstream/&amp;lt;id&amp;gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#e65100;fontColor=#a34000;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="680" height="470" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="invoke_agent orchestrator&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;session span = segment 1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="execute_tool SpawnAgent&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;toolSpanId from the call id&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="310" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="invoke_agent agent&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;parent = the spawn tool span&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="380" width="240" height="50" as="geometry" />
        </mxCell>
