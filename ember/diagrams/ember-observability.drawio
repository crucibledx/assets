        <mxCell id="p3-m1" parent="1" style="text;html=1;fontSize=10;align=left;fontColor=#37474F;whiteSpace=wrap;spacingLeft=5;" value="Requires THREE things simultaneously: a distribution system that tracks versions (Forge), a starter platform that versions skills (Starter), and a collection system that correlates usage (Ember). No single vendor can replicate this without building the entire ecosystem." vertex="1">
          <mxGeometry height="45" width="700" x="140" y="388" as="geometry" />
        </mxCell>
        <mxCell id="p3-punch" parent="1" style="text;html=1;fontSize=13;fontStyle=3;align=center;fontColor=#2D7600;whiteSpace=wrap;" value="&amp;ldquo;Ember is the only tool that knows what version of a skill your developers are actually using,&lt;br&gt;not just whether it&amp;rsquo;s installed, but whether it&amp;rsquo;s being invoked, and whether it&amp;rsquo;s safe to deprecate.&amp;rdquo;" vertex="1">
