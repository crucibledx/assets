        <mxCell id="bg" value="" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1300" height="890" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Slack bridge · Worker flow" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1260" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Each Slack message is checked, filtered, deduped, routed and recorded before the 200; delivery to the workstream relay runs after it, within the hourly budget, with retries and a pending queue" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="55" width="1260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="grp-slack" value="Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="160" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s-msg" value="Human message&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;top-level message or&lt;br&gt;thread reply&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="grp-req" value="Request path · POST /slack/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="855" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r-verify" value="Verify&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;256 KB cap, else 413 ·&lt;br&gt;signature and timestamp&lt;br&gt;within 300 s, else 401&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="215" y="145" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r-filter" value="Filter&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;bot · subtype ·&lt;br&gt;unmapped channel ·&lt;br&gt;external user: ignored&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="385" y="145" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r-dedupe" value="Dedupe&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;message record already&lt;br&gt;in KV: 200, stop&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="555" y="145" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r-route" value="Route&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;1 prefix or @mention&lt;br&gt;2 thread claim&lt;br&gt;3 channel map&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="725" y="145" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r-record" value="Record, then 200&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;message record; thread&lt;br&gt;map for a top-level&lt;br&gt;message (KV)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="895" y="145" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="grp-api" value="Workstream API · Bearer BRIDGE_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="290" width="575" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ws-agents" value="Workstream agents&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;Root, Forge, Ember and Other sessions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="535" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e-claim" value="POST /claim&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;hand a thread to a workstream&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="165" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-reserve" value="POST /reserve&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;Root, before it delivers to a project&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="225" y="420" width="165" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-ledger" value="GET /ledger&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;route and reply lines since a time&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="420" width="165" height="60" as="geometry" />
        </mxCell>
        <mxCell id="grp-state" value="Shared state · used by the request path, delivery and API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=bottom;spacingBottom=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="575" height="150" as="geometry" />
        </mxCell>
        <mxCell id="kv-thread" value="Thread map (KV)&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;channel + thread → workstream,&lt;br&gt;30 days, last claim wins&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="RelayGate&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;Durable Object per workstream,&lt;br&gt;50 runs per UTC hour&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="225" y="600" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="kv-msg" value="Message records (KV)&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;one per message; metadata&lt;br&gt;is the ledger line, 35 days&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="600" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="grp-del" value="Delivery · waitUntil and cron" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="615" y="290" width="440" height="370" as="geometry" />
        </mxCell>
        <mxCell id="cron" value="Cron every 10 min&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;up to 8 entries, expired&lt;br&gt;first, then oldest first&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="630" y="330" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="Pending (KV)&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;gate refusal or outage, 429,&lt;br&gt;5xx, network error or&lt;br&gt;timeout; deadline 1 h&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="630" y="440" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="giveup" value="Give up (D2)&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;401, 404, 413, other 4xx,&lt;br&gt;or past the deadline&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="630" y="570" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reserve" value="Reserve&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;RelayGate grant, valid&lt;br&gt;60 s; 2 s timeout,&lt;br&gt;fail closed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
