        </mxCell>
        <mxCell id="post" value="Relay POST&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;X-Webhook-Secret&lt;br&gt;5 s timeout, retries&lt;br&gt;after 2 s and 6 s&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
