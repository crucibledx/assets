        <mxCell id="p-budget" value="budget&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;fill the listing by priority; the rest deferred&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="715" y="250" width="115" height="90" as="geometry" /></mxCell>
        <mxCell id="p-guard" value="guardian&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;build crucible-guardian when anything is deferred or pruned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="250" width="115" height="90" as="geometry" /></mxCell>
