<mxfile host="assetkit">
  <diagram name="Forge compile pipeline" id="forge-compiler-pipeline">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1260" height="730" as="geometry" /></mxCell>
        <mxCell id="title" value="Forge compile pipeline" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1220" height="35" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="validate → resolve → compile → emit → install. Compile changes what forge delivers to each harness, never the source packages; nothing is deleted." style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1220" height="20" as="geometry" /></mxCell>
        <mxCell id="pkg" value="Plugin packages&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;Agent Plugins 1.0&lt;br&gt;git and local sources&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontColor=#00695c;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="validate" value="validate&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;manifests and components&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="resolve" value="resolve&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;pin versions in the lock&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="lock" value="Lock&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;outputs[harness] · variants[harness]&lt;br&gt;compile[harness].inputs + compiler version&lt;br&gt;crucible-guardian locked as source: generated; sync records the result&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="frame" value="compile · one unit per (harness, scope) · pure and byte-stable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=14;fontStyle=1;strokeWidth=3;verticalAlign=top;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="990" height="205" as="geometry" /></mxCell>
        <mxCell id="p-link" value="link&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;requires, subagent_type and /name edges&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="115" height="90" as="geometry" /></mxCell>
        <mxCell id="p-norm" value="normalize&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;fill name; Claude aliases → inherit (Droid)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="175" y="250" width="115" height="90" as="geometry" /></mxCell>
        <mxCell id="p-dedupe" value="dedupe&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;same skill twice: one is deferred&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310" y="250" width="115" height="90" as="geometry" /></mxCell>
        <mxCell id="p-prune" value="prune&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;opt-in: project profile&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="445" y="250" width="115" height="90" as="geometry" /></mxCell>
