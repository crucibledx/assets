<mxfile host="assetkit">
  <diagram name="Forge guardian flow" id="forge-guardian-flow">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1260" height="700" as="geometry" /></mxCell>
        <mxCell id="title" value="Forge guardian flow" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1220" height="35" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="The harness loads the hook and MCP server from the forge-generated crucible-guardian-&amp;lt;scope&amp;gt; plugin. They point the model at installed skills that compile left out of its listing." style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1220" height="20" as="geometry" /></mxCell>
        <mxCell id="user" value="User prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="170" height="45" as="geometry" /></mxCell>
        <mxCell id="harness" value="Harness&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;Droid · Claude Code&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="model" value="Model&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;cached prefix + prompt + note&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="275" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="frame" value="crucible-guardian-&amp;lt;scope&amp;gt; plugin · one per harness and scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=14;fontStyle=1;strokeWidth=3;verticalAlign=top;spacingTop=6;arcSize=3;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="620" height="440" as="geometry" /></mxCell>
        <mxCell id="hook" value="UserPromptSubmit hook&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;forge guardian hook --root&lt;br&gt;BM25 route; explicit mentions win&lt;br&gt;fail-open; CRUCIBLE_GUARDIAN=off silences it&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="160" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="note" value="Guardian note&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;at most 3 skills, appended after the&lt;br&gt;cached prefix; points at load_skill,&lt;br&gt;then the guardian/store path&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="mcp" value="MCP server&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;forge guardian mcp (stdio)&lt;br&gt;search_skills {query}: up to 5 matches&lt;br&gt;load_skill {name}: SKILL.md body&lt;br&gt;and bundled file paths&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="380" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="index" value="guardian/index.json&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;deferred and pruned skills, BM25 stats&lt;br&gt;schema, harness, scope, compile_inputs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="610" y="160" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="store" value="guardian/store&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;copies of deferred and pruned&lt;br&gt;skill directories&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="610" y="390" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="events" value="Guardian events&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;~/.crucible/forge/telemetry/&lt;br&gt;guardian-YYYY-MM-DD-&amp;lt;pid&amp;gt;.jsonl&lt;br&gt;only when telemetry.enabled&lt;br&gt;schema crucible.forge.guardian.v1&lt;br&gt;suggested · searched · loaded · failed&lt;br&gt;no prompt or query text&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="160" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="ember" value="Ember&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;reads the file and maps records&lt;br&gt;to ember.resource.* (Ember spec)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontColor=#a34000;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="380" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="scopes" value="Project-scope and user-scope guardians coexist under distinct names; each searches only its own index, so a prompt gets at most one note per scope. Debug with forge guardian route." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=10;fontStyle=0;strokeWidth=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="860" height="36" as="geometry" /></mxCell>
        <mxCell id="lg0" value="Legend" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#37474f;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="60" height="25" as="geometry" /></mxCell>
        <mxCell id="lg1" value="harness and model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a237e;fontSize=9;fontStyle=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="90" y="630" width="130" height="25" as="geometry" /></mxCell>
        <mxCell id="lg2" value="forge process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;fontSize=9;fontStyle=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="235" y="630" width="110" height="25" as="geometry" /></mxCell>
        <mxCell id="lg3" value="data or file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=9;fontStyle=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="360" y="630" width="110" height="25" as="geometry" /></mxCell>
        <mxCell id="lg4" value="Ember" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontColor=#a34000;fontSize=9;fontStyle=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="485" y="630" width="80" height="25" as="geometry" /></mxCell>
        <mxCell id="lg5" value="thin dashed line: data read or written" style="text;html=1;fontSize=9;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#37474f;" vertex="1" parent="1"><mxGeometry x="640" y="630" width="240" height="25" as="geometry" /></mxCell>
        <mxCell id="e-user-h" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#6c8ebf;fontColor=#1a237e;strokeWidth=2;flowAnimation=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="harness"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-h-hook" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#3f51b5;fontColor=#1a237e;strokeWidth=2;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="harness" target="hook"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-hook-index" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#bf9000;fontColor=#7f6000;dashed=1;strokeWidth=1;exitX=1;exitY=0.3333;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hook" target="index"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-hook-note" value="stdout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#3f51b5;fontColor=#1a237e;strokeWidth=2;flowAnimation=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hook" target="note"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-note-model" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#3f51b5;fontColor=#1a237e;strokeWidth=2;flowAnimation=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="note" target="model"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-model-mcp" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#6c8ebf;fontColor=#1a237e;strokeWidth=2;flowAnimation=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="model" target="mcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="435" /></Array></mxGeometry></mxCell>
        <mxCell id="e-mcp-index" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#bf9000;fontColor=#7f6000;dashed=1;strokeWidth=1;exitX=1;exitY=0.2273;exitDx=0;exitDy=0;entryX=0;entryY=0.7778;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mcp" target="index"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="405" /><mxPoint x="580" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="e-mcp-store" value="load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#bf9000;fontColor=#7f6000;dashed=1;strokeWidth=1;exitX=1;exitY=0.7273;exitDx=0;exitDy=0;entryX=0;entryY=0.7778;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mcp" target="store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-index-store" value="paths into" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#bf9000;fontColor=#7f6000;dashed=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="index" target="store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-hook-events" value="append" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#bf9000;fontColor=#7f6000;dashed=1;strokeWidth=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hook" target="events"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="498" y="135" /><mxPoint x="1090" y="135" /></Array></mxGeometry></mxCell>
        <mxCell id="e-mcp-events" value="append" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#bf9000;fontColor=#7f6000;dashed=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mcp" target="events"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="515" /><mxPoint x="905" y="515" /><mxPoint x="905" y="265" /></Array></mxGeometry></mxCell>
        <mxCell id="e-events-ember" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=2;strokeColor=#e65100;fontColor=#a34000;dashed=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="events" target="ember"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lg5-line" value="" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#455a64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="642" as="sourcePoint" /><mxPoint x="630" y="642" as="targetPoint" /></mxGeometry></mxCell>
      </root>
