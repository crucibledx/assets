<mxfile host="drawio">
  <diagram name="Multiplayer Slack" id="multiplayer-slack-v1">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1320" height="720" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Multiplayer Slack" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every human message in a bridged channel, top-level or in a thread, is pushed to one workstream by the Slack bridge and acked once its relay accepts it, never polled; Ember traces the session tree and the active Slack user" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="55" width="1280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="grp-slack" value="Slack · #crucible-work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="280" height="440" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="Nazar&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;top-level message&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="Teammate A&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;reply in a claimed thread&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="Teammate B&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;@Crucible ember: or forge: prefix&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s-reply" value="Thread replies&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;bridge ack once the relay accepts:&lt;br&gt;&quot;Sent to &amp;lt;Ws&amp;gt;.&quot; or an eyes reaction;&lt;br&gt;else a retrying / could-not-deliver&lt;br&gt;notice; the workstream answers&lt;br&gt;and @mentions the requester&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="grp-bridge" value="Slack bridge · Cloudflare Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=top;spacingTop=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="300" height="440" as="geometry" />
        </mxCell>
        <mxCell id="b-check" value="Verify · filter · dedupe&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;Slack signature · skip bots, external&lt;br&gt;users and unbridged channels · stop if&lt;br&gt;the message record (channel:ts) exists&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-route" value="Route + record, then 200&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;1 directive: prefix or @Crucible &amp;lt;ws&amp;gt;:&lt;br&gt;2 thread claim (KV)&lt;br&gt;3 channel map: #crucible-work → Root&lt;br&gt;then message record (KV), and the&lt;br&gt;thread map for a top-level message&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="270" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-deliver" value="Deliver&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;reserve from the hourly budget ·&lt;br&gt;relay POST with retries, else&lt;br&gt;pending for the cron · ack only&lt;br&gt;after the relay answers 2xx&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="grp-ws" value="Workstreams · relay webhooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#455a64;fontColor=#37474f;fontSize=13;fontStyle=1;strokeWidth=2;verticalAlign=bottom;spacingBottom=5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="745" y="100" width="280" height="455" as="geometry" />
        </mxCell>
        <mxCell id="ws-root" value="Root&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;routes #crucible-work requests:&lt;br&gt;issue (ws:* label), thread claim,&lt;br&gt;reserve, POST to the project relay&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="760" y="115" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ws-forge" value="Crucible · Forge&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;orchestrator + one agent per&lt;br&gt;issue, within its budget → its PR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="760" y="220" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ws-ember" value="Crucible · Ember&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;orchestrator + one agent per&lt;br&gt;issue, within its budget → its PR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="760" y="325" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ws-other" value="Crucible · Other&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;orchestrator + one agent per&lt;br&gt;issue, within its budget → its PR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="760" y="430" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="em-out" value="Dashboard&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;the session tree and who&lt;br&gt;asked / is active&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1090" y="110" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="em-trace" value="Ember&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;joins every session, subagent&lt;br&gt;and tool call (OTLP) into one&lt;br&gt;tree: Root → workstream →&lt;br&gt;agent; attributes it to the&lt;br&gt;active Slack user&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1090" y="200" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="slack-ledger.jsonl&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;route · reply lines: Root mirrors&lt;br&gt;the bridge's GET /ledger; projects&lt;br&gt;append agent · pr lines;&lt;br&gt;usage per requester&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1090" y="425" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-u1-check" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#b85450;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1" target="b-check">
