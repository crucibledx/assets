        <mxCell id="l-orch" value="Workstream&lt;br&gt;orchestrator&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;triages the report,&lt;br&gt;traces the cause,&lt;br&gt;assigns the fix&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
