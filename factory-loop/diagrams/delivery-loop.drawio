        <mxCell id="e-merge-tag" value="merged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#00897b;fontColor=#00695c;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l-merge" target="l-tag">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
