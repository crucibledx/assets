        <mxCell id="c45" value="&lt;b&gt;Estimating rule&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;one 5-hour window ≈ 1 hour of work&lt;/i&gt;&lt;br&gt;&lt;br&gt;plan ~5 active hours and ~25 PRs per day&lt;br&gt;S ~1 h · M 1–2 h · L 2–3 h · spec ~6 h&lt;br&gt;&lt;b&gt;+½ day per step in a dependency chain&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;fontColor=#333333;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880.0" y="290" width="380.0" height="150" as="geometry" /></mxCell>
